{
  "name": "midi-web-visuals-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A starter template for browser-based MIDI-controlled visuals with Three.js, p5.js, TypeScript, and Vite.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "lil-gui": "0.20.0",
    "p5": "1.11.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@types/p5": "1.7.6",
    "@types/three": "0.169.0",
    "eslint": "9.14.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.14.0",
    "vite": "5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
